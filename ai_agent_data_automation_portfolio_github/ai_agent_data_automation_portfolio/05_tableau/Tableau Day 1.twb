      <column caption='2021년 매출' datatype='real' name='[2020년 매출(복사본)_0530300374732808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if YEAR([주문 일자]) = 2021 THEN [매출] END' />
      </column>
      <column caption='평균 이상 미만 구분' datatype='boolean' name='[Calculation_0530300325896193]' role='measure' type='nominal'>
        <calculation class='tableau' formula='sum([매출]) &gt; WINDOW_AVG(sum([매출]))'>
